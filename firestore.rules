rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(fid) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.members;
    }

    // 每個人只能讀寫自己的帳號資料（記錄屬於哪個家庭）
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /families/{fid} {
      // 建立家庭：成員只能有自己
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      // 只有家庭成員看得到
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // 成員可以修改；持有邀請碼的人只能「把自己加進成員」
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.members.size() == resource.data.members.size() + 1 &&
          request.auth.uid in request.resource.data.members
        )
      );
      allow delete: if false;

      // 行程與收支：只有家庭成員能讀寫
      match /{sub}/{docId} {
        allow read, write: if isMember(fid);
      }
    }
  }
}
